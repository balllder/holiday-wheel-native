# Database path (SQLite) - use DB_PATH or DATABASE_URL
DB_PATH=puzzles.db
# DATABASE_URL=sqlite:puzzles.db

# Server port
PORT=5000

# Admin bootstrap - email address to automatically grant admin privileges
# ADMIN_EMAIL=admin@example.com

# SSL/TLS configuration (optional)
SSL_ENABLED=false
# SSL_CERT=/path/to/cert.pem
# SSL_KEY=/path/to/key.pem

# Logging level
RUST_LOG=info

# Host code for claiming host mode
HOST_CODE=holiday

# Email configuration
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@holidaywheel.com
BASE_URL=http://localhost:5000

# WebAuthn/Passkey configuration
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Holiday Wheel
WEBAUTHN_RP_ORIGIN=http://localhost:5000

# Google OAuth (get credentials from https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=

# Apple Sign-In (get credentials from https://developer.apple.com)
# For native apps (iOS/tvOS):
APPLE_CLIENT_ID=com.holidaywheel.phone
# APPLE_TEAM_ID=

# For web client (requires Services ID and redirect URI):
# APPLE_CLIENT_ID_WEB=com.holidaywheel.web
# APPLE_REDIRECT_URI=https://your-domain.com/auth/api/oauth/apple/callback
