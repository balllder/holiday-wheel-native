# Project Environment Configuration
# Copy this file to .env and customize values for your project
#
# SECURITY: Never commit .env to git (.env should be in .gitignore)
# PRODUCTION: Use strong, random values for all secrets

# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection string
# Format: postgres://user:password@host:port/database
DATABASE_URL=postgres://myuser:mypassword@localhost:5432/mydb

# Test database (for integration tests)
TEST_DATABASE_URL=postgres://myuser:mypassword@localhost:5432/mydb_test

# Connection pool settings
DATABASE_MAX_CONNECTIONS=10
DATABASE_TIMEOUT_SECONDS=30

# PostgreSQL credentials (for Docker Compose)
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=mydb

# ============================================
# Cache Configuration (Optional)
# ============================================
# Redis connection string
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=5

# ============================================
# Application Configuration
# ============================================
# Service name and environment
APP_NAME=my-service
APP_ENV=development
NODE_ENV=development

# Server binding
HOST=0.0.0.0
PORT=3000

# CORS Configuration
# WARNING: NEVER use * in production - this creates a critical CSRF vulnerability
# Example for multiple origins: http://localhost:4200,https://app.example.com
ALLOWED_ORIGINS=http://localhost:4200

# ============================================
# Logging Configuration
# ============================================
# Log level: trace, debug, info, warn, error
LOG_LEVEL=info
LOG_FORMAT=json

# Stack-specific logging (uncomment as needed)
# RUST_LOG=debug,sqlx=warn,tower_http=debug  # Rust
# RUST_BACKTRACE=1                           # Rust
# DEBUG=express:*                            # Node.js/Express
# PYTHONUNBUFFERED=1                         # Python

# ============================================
# Security Configuration
# ============================================
# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=change-me-in-production-use-strong-random-value
JWT_EXPIRATION_SECONDS=3600  # 1 hour

# API Key (for internal service authentication)
API_KEY=change-me-in-production

# Session secret (for session-based auth)
SESSION_SECRET=change-me-in-production-use-strong-random-value
SESSION_LIFETIME_SECONDS=86400  # 24 hours

# Encryption key (32-byte hex for AES-256)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ============================================
# Password Hashing (Argon2)
# ============================================
ARGON2_MEMORY_SIZE=65536     # 64 MB
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# ============================================
# External Services (Optional)
# ============================================
# Email service (SendGrid, Mailgun, etc.)
# EMAIL_API_KEY=
# EMAIL_FROM=noreply@example.com

# Payment service (Stripe, etc.)
# STRIPE_API_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Storage service (S3, etc.)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=

# ============================================
# Feature Flags
# ============================================
ENABLE_METRICS=true
ENABLE_TRACING=true
ENABLE_PROFILING=false
ENABLE_RATE_LIMITING=true

# ============================================
# Monitoring & Observability (Optional)
# ============================================
# OpenTelemetry
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=my-service

# Sentry (Error tracking)
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_ENVIRONMENT=development

# ============================================
# Development Configuration
# ============================================
# Hot reload (stack-specific)
# CARGO_WATCH_ENABLED=true  # Rust
# NODEMON_ENABLED=true      # Node.js

# Seed data
SEED_DATABASE=false

# Mock external services in development
MOCK_EXTERNAL_SERVICES=true

# ============================================
# Testing Configuration
# ============================================
# Test mode flags
TEST_MODE=false
E2E_BASE_URL=http://localhost:3000

# ============================================
# Production-Only Settings
# ============================================
# (Move these to .env.production for production deployment)
# SSL/TLS
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem

# Database connection pooling (production)
# DATABASE_MAX_CONNECTIONS=50
# DATABASE_MIN_CONNECTIONS=5

# Performance tuning
# MAX_REQUEST_SIZE_MB=10
# REQUEST_TIMEOUT_SECONDS=30
