#!/bin/bash
#
# Pre-commit hook
#
# Runs validation checks before allowing commits.
# This ensures code quality and prevents broken code from being committed.
#
# Installation:
#   cp templates/git-hooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# To bypass (use sparingly):
#   git commit --no-verify

set -e  # Exit on first error

echo "🔍 Running pre-commit checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to print colored output
print_error() {
    echo -e "${RED}✗ $1${NC}"
}

print_success() {
    echo -e "${GREEN}✓ $1${NC}"
}

print_warning() {
    echo -e "${YELLOW}⚠ $1${NC}"
}

# Track if any checks failed
CHECKS_FAILED=0

#=============================================================================
# 1. Code Formatting
#=============================================================================

echo ""
echo "📝 Checking code formatting..."

# Rust formatting check (if Cargo.toml exists)
if [ -f "Cargo.toml" ]; then
    if ! cargo fmt -- --check > /dev/null 2>&1; then
        print_error "Rust code formatting check failed"
        print_warning "Run: cargo fmt"
        CHECKS_FAILED=1
    else
        print_success "Rust formatting OK"
    fi
fi

# Python formatting check (if requirements.txt or pyproject.toml exists)
if [ -f "requirements.txt" ] || [ -f "pyproject.toml" ]; then
    if command -v black > /dev/null 2>&1; then
        if ! black --check . > /dev/null 2>&1; then
            print_error "Python code formatting check failed"
            print_warning "Run: black ."
            CHECKS_FAILED=1
        else
            print_success "Python formatting OK"
        fi
    fi
fi

# JavaScript/TypeScript formatting check (if package.json exists)
if [ -f "package.json" ]; then
    if [ -f "node_modules/.bin/prettier" ]; then
        if ! npm run format:check > /dev/null 2>&1; then
            print_error "JavaScript/TypeScript formatting check failed"
            print_warning "Run: npm run format"
            CHECKS_FAILED=1
        else
            print_success "JavaScript/TypeScript formatting OK"
        fi
    fi
fi

#=============================================================================
# 2. Linting
#=============================================================================

echo ""
echo "🔍 Running linters..."

# Rust linting (if Cargo.toml exists)
# Use --all-targets --all-features to catch ALL warnings (same as pre-push)
if [ -f "Cargo.toml" ]; then
    if ! cargo clippy --all-targets --all-features -- -D warnings 2>&1; then
        echo ""
        print_error "Rust linting failed"
        print_warning "Run: cargo clippy --all-targets --all-features --fix"
        CHECKS_FAILED=1
    else
        print_success "Rust linting OK"
    fi
fi

# Python linting (if requirements.txt exists)
if [ -f "requirements.txt" ] || [ -f "pyproject.toml" ]; then
    if command -v ruff > /dev/null 2>&1; then
        if ! ruff check . > /dev/null 2>&1; then
            print_error "Python linting failed"
            print_warning "Run: ruff check ."
            CHECKS_FAILED=1
        else
            print_success "Python linting OK"
        fi
    fi
fi

# JavaScript/TypeScript linting (if package.json exists)
if [ -f "package.json" ]; then
    if [ -f "node_modules/.bin/eslint" ]; then
        if ! npm run lint > /dev/null 2>&1; then
            print_error "JavaScript/TypeScript linting failed"
            print_warning "Run: npm run lint"
            CHECKS_FAILED=1
        else
            print_success "JavaScript/TypeScript linting OK"
        fi
    fi
fi

#=============================================================================
# 3. Type Checking
#=============================================================================

echo ""
echo "🔬 Running type checks..."

# TypeScript type checking (if tsconfig.json exists)
if [ -f "tsconfig.json" ]; then
    if [ -f "node_modules/.bin/tsc" ]; then
        if ! npm run type-check > /dev/null 2>&1; then
            print_error "TypeScript type checking failed"
            print_warning "Run: npm run type-check"
            CHECKS_FAILED=1
        else
            print_success "TypeScript type checking OK"
        fi
    fi
fi

# Python type checking (if using mypy)
if [ -f "requirements.txt" ] || [ -f "pyproject.toml" ]; then
    if command -v mypy > /dev/null 2>&1; then
        if ! mypy . > /dev/null 2>&1; then
            print_error "Python type checking failed"
            print_warning "Run: mypy ."
            CHECKS_FAILED=1
        else
            print_success "Python type checking OK"
        fi
    fi
fi

#=============================================================================
# 4. OpenAPI Schema Validation
#=============================================================================

echo ""
echo "📋 Validating OpenAPI schema..."

# Check if backend has utoipa (Rust OpenAPI generator)
if [ -f "backend/Cargo.toml" ] && grep -q "utoipa" backend/Cargo.toml; then
    # Check if generate-openapi binary exists and can compile
    if ! cd backend && cargo build --bin generate-openapi > /dev/null 2>&1; then
        print_error "OpenAPI schema generation failed"
        print_warning "Failed to compile generate-openapi binary"
        print_warning "Check your utoipa annotations"
        CHECKS_FAILED=1
        cd ..
    else
        # Try to generate schema to validate annotations
        if ! cargo run --bin generate-openapi > /dev/null 2>&1; then
            print_error "OpenAPI schema validation failed"
            print_warning "utoipa annotations may be incomplete or invalid"
            print_warning "Run: cargo run --bin generate-openapi to see errors"
            CHECKS_FAILED=1
        else
            print_success "OpenAPI schema is valid"
        fi
        cd ..
    fi
fi

#=============================================================================
# 5. TypeScript Codegen Check
#=============================================================================

echo ""
echo "🔄 Checking generated TypeScript client..."

# Check if Makefile has codegen-check target
if grep -q "^codegen-check:" Makefile 2>/dev/null; then
    if ! make codegen-check > /dev/null 2>&1; then
        print_error "Generated code is out of date"
        print_warning "Backend API changes detected but TypeScript client not regenerated"
        print_warning "Run: make codegen-all"
        print_warning "Then commit the generated files"
        CHECKS_FAILED=1
    else
        print_success "Generated code is up-to-date"
    fi
fi

#=============================================================================
# 6. Unit Tests (Optional - can be slow)
#=============================================================================

# Uncomment to run unit tests before commit (can slow down commits)
