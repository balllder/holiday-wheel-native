#     print_warning "Run: make test-unit"
#     CHECKS_FAILED=1
# else
#     print_success "Unit tests OK"
# fi

#=============================================================================
# 7. Security Checks
#=============================================================================

echo ""
echo "🔒 Running security checks..."

# Check for common secrets patterns
if git diff --cached | grep -iE "(api_key|secret|password|token)\s*=\s*['\"][^'\"]+['\"]" > /dev/null 2>&1; then
    print_warning "Potential secret found in staged changes"
    print_warning "Review carefully before committing"
fi

# Rust security audit (if Cargo.lock exists)
if [ -f "Cargo.lock" ]; then
    if command -v cargo-audit > /dev/null 2>&1; then
        if ! cargo audit > /dev/null 2>&1; then
            print_warning "Cargo security audit found vulnerabilities"
            print_warning "Run: cargo audit for details"
        fi
    fi
fi

# Python security check (if using safety)
if [ -f "requirements.txt" ]; then
    if command -v safety > /dev/null 2>&1; then
        if ! safety check > /dev/null 2>&1; then
            print_warning "Python security check found vulnerabilities"
            print_warning "Run: safety check for details"
        fi
    fi
fi

#=============================================================================
# 8. Commit Message Validation (Optional)
#=============================================================================

# Uncomment to enforce conventional commits
