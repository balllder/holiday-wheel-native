#         print_error "Commit message does not follow conventional commits format"
#         print_warning "Format: type(scope): description"
#         print_warning "Example: feat(auth): add login endpoint"
#         CHECKS_FAILED=1
#     fi
# fi

#=============================================================================
# Result
#=============================================================================

echo ""
if [ $CHECKS_FAILED -eq 1 ]; then
    print_error "Pre-commit checks failed"
    echo ""
    echo "Fix the issues above and try again."
    echo "Or use --no-verify to bypass (not recommended):"
    echo "  git commit --no-verify"
    echo ""
    exit 1
else
    print_success "All pre-commit checks passed!"
    echo ""
    exit 0
fi
