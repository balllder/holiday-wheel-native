const mockComponent = (name) => {
  const React = require('react');
  return ({ children, ...props }) => React.createElement(name, props, children);
};

const StyleSheet = {
  create: (styles) => styles,
  flatten: (style) => {
    if (Array.isArray(style)) {
      return Object.assign({}, ...style.filter(Boolean));
    }
    return style || {};
  },
};

