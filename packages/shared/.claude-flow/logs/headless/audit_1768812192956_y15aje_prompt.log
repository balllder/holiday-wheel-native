      shadowRadius: 15,
      elevation: 10,
    },
  },

  // Typography scale
  typography: {
    fontSize: {
      xs: 10,
      sm: 12,
      md: 14,
      lg: 16,
      xl: 18,
      '2xl': 24,
      '3xl': 30,
      '4xl': 36,
    },
    fontWeight: {
      normal: '400' as const,
      medium: '500' as const,
      semibold: '600' as const,
      bold: '700' as const,
    },
  },

  // Animation durations (in ms)
  animation: {
    fast: 150,
    normal: 300,
    slow: 500,
  },

