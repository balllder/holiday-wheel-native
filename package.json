{
  "name": "holiday-wheel-native",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:e2e": "cd e2e && npm test",
    "test:e2e:headed": "cd e2e && npm run test:headed",
    "test:e2e:ui": "cd e2e && npm run test:ui",
    "test:e2e:report": "cd e2e && npm run report",
    "test:maestro:phone": "cd apps/phone && maestro test .maestro/",
    "test:maestro:tv": "cd apps/tv && maestro test .maestro/",
    "test:maestro:all": "npm run test:maestro:phone && npm run test:maestro:tv",
    "validate:js": "node scripts/extract-rust-js.js && node scripts/validate-rust-js.js"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.7.4",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.2.4",
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ]
}
