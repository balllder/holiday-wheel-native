# Production Environment Configuration
# This file contains production-specific settings
# SECURITY: Store secrets in secure secret management (AWS Secrets Manager, HashiCorp Vault, etc.)

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgres://user:password@prod-db.example.com:5432/prod_db
DATABASE_MAX_CONNECTIONS=50
DATABASE_MIN_CONNECTIONS=5
DATABASE_TIMEOUT_SECONDS=10
DATABASE_SSL_MODE=require

# ============================================
# Cache Configuration
# ============================================
REDIS_URL=redis://prod-redis.example.com:6379
REDIS_PASSWORD=${REDIS_PASSWORD}  # Load from secret manager
REDIS_MAX_CONNECTIONS=20
REDIS_SSL_ENABLED=true

# ============================================
# Application Configuration
# ============================================
APP_NAME=my-service
APP_ENV=production
NODE_ENV=production

HOST=0.0.0.0
PORT=3000

# CORS - Explicitly list allowed origins
ALLOWED_ORIGINS=https://app.example.com,https://www.example.com

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=warn
LOG_FORMAT=json

# Disable debug logging in production
RUST_LOG=warn,sqlx=error
DEBUG=

# ============================================
# Security Configuration
# ============================================
# CRITICAL: Use strong, random values from secret manager
JWT_SECRET=${JWT_SECRET}  # Load from secret manager
JWT_EXPIRATION_SECONDS=900  # 15 minutes (shorter in production)

API_KEY=${API_KEY}  # Load from secret manager

SESSION_SECRET=${SESSION_SECRET}  # Load from secret manager
SESSION_LIFETIME_SECONDS=43200  # 12 hours

ENCRYPTION_KEY=${ENCRYPTION_KEY}  # Load from secret manager

# ============================================
# SSL/TLS Configuration
# ============================================
SSL_ENABLED=true
SSL_CERT_PATH=/etc/ssl/certs/cert.pem
SSL_KEY_PATH=/etc/ssl/private/key.pem

# ============================================
# Rate Limiting (Stricter in Production)
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=30
RATE_LIMIT_REQUESTS_PER_HOUR=500

# ============================================
# External Services
# ============================================
EMAIL_API_KEY=${EMAIL_API_KEY}  # Load from secret manager
EMAIL_FROM=noreply@example.com

STRIPE_API_KEY=${STRIPE_API_KEY}  # Load from secret manager
STRIPE_WEBHOOK_SECRET=${STRIPE_WEBHOOK_SECRET}  # Load from secret manager

AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}  # Load from secret manager
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}  # Load from secret manager
AWS_S3_BUCKET=prod-app-storage

# ============================================
# Feature Flags
# ============================================
ENABLE_METRICS=true
ENABLE_TRACING=true
ENABLE_PROFILING=false
ENABLE_RATE_LIMITING=true

# ============================================
# Monitoring & Observability
# ============================================
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.example.com:4317
OTEL_SERVICE_NAME=my-service-prod

SENTRY_DSN=${SENTRY_DSN}  # Load from secret manager
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1  # 10% sampling in production

# ============================================
# Performance Tuning
# ============================================
MAX_REQUEST_SIZE_MB=10
REQUEST_TIMEOUT_SECONDS=30
WORKER_THREADS=4

# ============================================
# Health Checks
# ============================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
READINESS_CHECK_PATH=/ready

# ============================================
# Backup & Recovery
# ============================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # 2 AM daily
BACKUP_RETENTION_DAYS=30

# ============================================
# Production Safety
# ============================================
# Disable development features
SEED_DATABASE=false
MOCK_EXTERNAL_SERVICES=false
CARGO_WATCH_ENABLED=false
NODEMON_ENABLED=false
TEST_MODE=false
