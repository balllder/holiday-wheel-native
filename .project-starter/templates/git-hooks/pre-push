#!/bin/bash
#
# Pre-push hook
#
# Runs comprehensive validation before allowing pushes to remote.
# This is the last line of defense to prevent broken code from reaching the repository.
#
# Installation:
#   cp templates/git-hooks/pre-push .git/hooks/pre-push
#   chmod +x .git/hooks/pre-push
#
# To bypass (use sparingly):
#   git push --no-verify

set -e  # Exit on first error

echo "🚀 Running pre-push checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to print colored output
print_error() {
    echo -e "${RED}✗ $1${NC}"
}

print_success() {
    echo -e "${GREEN}✓ $1${NC}"
}

print_warning() {
    echo -e "${YELLOW}⚠ $1${NC}"
}

# Track if any checks failed
CHECKS_FAILED=0

#=============================================================================
# 1. Code Formatting
#=============================================================================

echo ""
echo "📝 Checking code formatting..."

# Rust formatting check (if Cargo.toml exists)
if [ -f "Cargo.toml" ]; then
    if ! cargo fmt -- --check; then
        print_error "Rust code formatting check failed"
        print_warning "Run: cargo fmt"
        CHECKS_FAILED=1
    else
        print_success "Rust formatting OK"
    fi
fi

# Python formatting check (if requirements.txt or pyproject.toml exists)
if [ -f "requirements.txt" ] || [ -f "pyproject.toml" ]; then
    if command -v black > /dev/null 2>&1; then
        if ! black --check .; then
            print_error "Python code formatting check failed"
            print_warning "Run: black ."
            CHECKS_FAILED=1
        else
            print_success "Python formatting OK"
        fi
    fi
fi

# JavaScript/TypeScript formatting check (if package.json exists)
if [ -f "package.json" ]; then
    if [ -f "node_modules/.bin/prettier" ]; then
        if ! npm run format:check; then
            print_error "JavaScript/TypeScript formatting check failed"
            print_warning "Run: npm run format"
            CHECKS_FAILED=1
        else
            print_success "JavaScript/TypeScript formatting OK"
        fi
    fi
fi

#=============================================================================
# 2. Linting - STRICT MODE (all warnings treated as errors)
#=============================================================================

echo ""
echo "🔍 Running linters (strict mode)..."

# Rust linting (if Cargo.toml exists)
# Use --all-targets --all-features to catch ALL warnings including tests and binaries
if [ -f "Cargo.toml" ]; then
    if ! cargo clippy --all-targets --all-features -- -D warnings 2>&1; then
        echo ""
        print_error "Rust linting failed"
        print_warning "Run: cargo clippy --all-targets --all-features --fix"
        CHECKS_FAILED=1
    else
        print_success "Rust linting OK"
    fi
fi

# Python linting (if requirements.txt exists)
if [ -f "requirements.txt" ] || [ -f "pyproject.toml" ]; then
    if command -v ruff > /dev/null 2>&1; then
        if ! ruff check .; then
            print_error "Python linting failed"
            print_warning "Run: ruff check . --fix"
            CHECKS_FAILED=1
        else
            print_success "Python linting OK"
        fi
    fi
fi

# JavaScript/TypeScript linting (if package.json exists)
if [ -f "package.json" ]; then
    if [ -f "node_modules/.bin/eslint" ]; then
        if ! npm run lint; then
            print_error "JavaScript/TypeScript linting failed"
            print_warning "Run: npm run lint -- --fix"
            CHECKS_FAILED=1
        else
            print_success "JavaScript/TypeScript linting OK"
        fi
    fi
fi

#=============================================================================
# 3. Type Checking
#=============================================================================

echo ""
echo "🔬 Running type checks..."

# TypeScript type checking (if tsconfig.json exists)
if [ -f "tsconfig.json" ]; then
    if [ -f "node_modules/.bin/tsc" ]; then
        if ! npm run type-check; then
            print_error "TypeScript type checking failed"
            print_warning "Fix type errors before pushing"
            CHECKS_FAILED=1
        else
            print_success "TypeScript type checking OK"
        fi
    fi
fi

# Python type checking (if using mypy)
if [ -f "requirements.txt" ] || [ -f "pyproject.toml" ]; then
    if command -v mypy > /dev/null 2>&1; then
        if ! mypy .; then
            print_error "Python type checking failed"
            print_warning "Run: mypy . to see details"
            CHECKS_FAILED=1
        else
            print_success "Python type checking OK"
        fi
    fi
fi

# Rust build check (if Cargo.toml exists)
if [ -f "Cargo.toml" ]; then
    if ! cargo check --all-features; then
        print_error "Rust compilation failed"
        print_warning "Fix compilation errors before pushing"
        CHECKS_FAILED=1
    else
        print_success "Rust compilation OK"
    fi
fi

#=============================================================================
# 4. Tests
#=============================================================================

echo ""
echo "🧪 Running tests..."

# Rust tests (if Cargo.toml exists)
if [ -f "Cargo.toml" ]; then
    if ! cargo test --all-features; then
        print_error "Rust tests failed"
        print_warning "Fix failing tests before pushing"
        CHECKS_FAILED=1
    else
        print_success "Rust tests OK"
    fi
fi

# Python tests (if pytest is available)
if [ -f "requirements.txt" ] || [ -f "pyproject.toml" ]; then
    if command -v pytest > /dev/null 2>&1; then
        if ! pytest; then
            print_error "Python tests failed"
            print_warning "Fix failing tests before pushing"
            CHECKS_FAILED=1
        else
            print_success "Python tests OK"
        fi
    fi
fi

# JavaScript/TypeScript tests (if package.json has test script)
if [ -f "package.json" ]; then
    if grep -q "\"test\"" package.json; then
        if ! npm test; then
            print_error "JavaScript/TypeScript tests failed"
            print_warning "Fix failing tests before pushing"
            CHECKS_FAILED=1
        else
            print_success "JavaScript/TypeScript tests OK"
        fi
    fi
fi

#=============================================================================
# 5. Security Checks
#=============================================================================

echo ""
echo "🔒 Running security checks..."

# Rust security audit (if Cargo.lock exists)
if [ -f "Cargo.lock" ]; then
    if command -v cargo-audit > /dev/null 2>&1; then
        if ! cargo audit; then
            print_warning "Cargo security audit found vulnerabilities"
            print_warning "Run: cargo audit for details"
            # Don't fail on security warnings, but notify
        else
            print_success "Rust security audit OK"
        fi
    fi
fi

# Python security check (if using safety)
if [ -f "requirements.txt" ]; then
    if command -v safety > /dev/null 2>&1; then
        if ! safety check; then
            print_warning "Python security check found vulnerabilities"
            print_warning "Run: safety check for details"
            # Don't fail on security warnings, but notify
        else
            print_success "Python security audit OK"
        fi
    fi
fi

#=============================================================================
# Result
#=============================================================================

echo ""
if [ $CHECKS_FAILED -eq 1 ]; then
    print_error "Pre-push checks failed"
    echo ""
    echo "Fix the issues above before pushing."
    echo "Or use --no-verify to bypass (not recommended):"
    echo "  git push --no-verify"
    echo ""
    exit 1
else
    print_success "All pre-push checks passed!"
    print_success "Your code is ready to push! 🚀"
    echo ""
    exit 0
fi
